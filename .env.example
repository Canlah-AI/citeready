# Copy to .env.local and fill in with YOUR Firebase project's web app config.
# (Firebase console > Project settings > Your apps > Web app > SDK setup and configuration)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

# App Check (required by Firebase AI Logic). reCAPTCHA Enterprise *site* key (public by design).
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Local development only: an App Check debug token you registered in
# Firebase console > App Check > Apps > Manage debug tokens. Never commit a real one.
# Leave empty to have the SDK print a fresh debug token in the browser console.
VITE_APPCHECK_DEBUG_TOKEN=
